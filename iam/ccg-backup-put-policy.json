{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UnggahBackupSaja",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::ccg-backup-25832072005/ccg/*"
    },
    {
      "Sid": "DaftarPrefixBackup",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::ccg-backup-25832072005",
      "Condition": {"StringLike": {"s3:prefix": ["ccg/*"]}}
    }
  ]
}
